{
  "name": "nrel/nrel_bootstrap_module",
  "description": "Companion module to the NREL Bootstrap theme.",
  "type": "drupal-module",
  "license": "GPL-2.0",
  "prefer-stable": true,
  "minimum-stability": "dev",
  "homepage": "https://github.com/NatLabRockies/nrel_bootstrap_module",
  "authors": [
    {
      "name": "Shaun Laws (slaws)",
      "email": "shaun.laws@nlr.gov",
      "role": "Maintainer"
    }
  ],
  "support": {
    "issues": "https://github.com/NatLabRockies/nrel_bootstrap_module/issues"
  },
  "repositories": {
    "drupal": {
      "type": "composer",
      "url": "https://packages.drupal.org/8"
    },
    "assets": {
      "type": "composer",
      "url": "https://packagist-repo.nrel.gov/nrel/communications/",
      "options": {
          "ssl": {
              "verify_peer": false,
              "allow_self_signed": true
          }
      }
  }
},
  "require": {
    "nrel/nrel_bootstrap": "dev-bootstrap5",
    "drupal/core": "^10.5"
  },
  "config": {
    "allow-plugins": {
      "drupal/core-composer-scaffold": true
    }
  }
}
